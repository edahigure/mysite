<h1 align="center">Create new category</h1>

<%= render 'shared/errors', obj: @category%>

<%= form_with(model: @category, data: { turbo: false }) do |f| %>
    <div class="row mb-3 ">
        <div class="col-sm-2">
            <%= f.label :name, class: "form-label mb-0" %>
        </div>
        <div class="col-sm-8 offset-sm-2">
            <%= f.text_field :name, 
                class: "form-control", 
                placeholder: "Enter user name",
                autofocus: true %>
        </div>
    </div>
    
    <div class="row mb-3">
        <div class="col-sm-10 offset-sm-2">
            <%= f.submit class: "btn btn-primary btn-lg me-2" %> 
            <%= link_to "Cancel and return to articles", 
                articles_path, 
                class: "btn btn-outline-secondary" %>
        </div>
    </div>
<% end %>
