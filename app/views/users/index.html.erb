<h1 align="center"> All users <h1>

<div align="center">
    <% @users.each do |user| %>
        <ul class="listing">
            <div class="row">
                
            <div class="card p-3 col-md-4 offset-md-4 bg-light"> 
                    <li><%= link_to gravatar_for(user),user_path(user)  %>  </li>
                    <li class="article-title">
                        <%= link_to user.username, user_path(user) %>
                    </li>
                    <li><small><%= pluralize(user.articles.count,"article") if user.articles %> </small></li>
                    <% if logged_in? and current_user.admin? %>
                        <li> 
                            <%= button_to "Delete", user_path(user), 
                            method: :delete, 
                            form: { data: { turbo_confirm: "¿Estás seguro?" } }, 
                            turbo_frame: "_top",
                            turbo_action: "advance",
                            class: "btn btn-xs btn-danger" %> 
                         </li>
                    <% end %>
                </div>
            </div>
        </ul>
    <%end%>
</div>


<div class="d-flex justify-content-center"> 
<%=render 'paginator_user'%>
</div>
